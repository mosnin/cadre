---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title="Support · Cadre" description="Get help with the Cadre app and self-hosted Cadre.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Cadre support</h1>
      <p>
        For help with the Cadre mobile app or a hosted Cadre account, email{" "}
        <a href="mailto:hello@cadre.com">hello@cadre.com</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2>Self-hosted Cadre</h2>
      <p>
        For help running Cadre on your own infrastructure, or to report a reproducible bug, email{" "}
        <a href="mailto:hello@cadre.com">hello@cadre.com</a> with your deployment details.
      </p>
      <h2>Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
