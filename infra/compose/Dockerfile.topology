FROM node:22-bookworm

RUN corepack enable
WORKDIR /app
# Normalize modes: a restrictive host umask (e.g. 077 on hardened hosts) would otherwise
# leave the copied tree unreadable to USER node at runtime.
COPY --chmod=755 . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cadre/db generate
RUN install -d -m 750 -o node -g node /data

ENV NODE_ENV=production
EXPOSE 3100 7091
USER node
CMD ["pnpm", "--filter", "@cadre/api", "start"]
